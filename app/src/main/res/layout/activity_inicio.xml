<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".InicioActivity">

    <!-- TÍTULO MINIMODA -->
    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_marca"
        style="@style/TextAppearance.Minimoda.Titulo"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ICONO BOLSA DE COMPRA -->
    <ImageView
        android:id="@+id/iv_bolsa"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_menu_slideshow"
        app:layout_constraintBottom_toBottomOf="@id/tv_titulo"
        app:layout_constraintStart_toEndOf="@id/tv_titulo"
        app:layout_constraintTop_toTopOf="@id/tv_titulo"
        app:tint="@color/verde_boton" />

    <!-- BARRA DE BÚSQUEDA -->
    <EditText
        android:id="@+id/et_buscar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:background="@color/gris_buscador"
        android:hint="@string/hint_buscar"
        android:paddingStart="16dp"
        android:textColorHint="@color/texto_secundario"
        android:textSize="14sp"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo" />

    <!-- CATEGORÍAS (Botones horizontales) -->
    <LinearLayout
        android:id="@+id/layout_categorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_buscar">

        <Button
            android:id="@+id/btn_bebe"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:backgroundTint="@color/verde_boton"
            android:text="@string/cat_bebe"
            android:textSize="11sp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            style="@style/TextAppearance.Minimoda.Boton" />

        <Button
            android:id="@+id/btn_infantil"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:backgroundTint="@color/verde_boton"
            android:text="@string/cat_infantil"
            android:textSize="11sp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            style="@style/TextAppearance.Minimoda.Boton" />

        <Button
            android:id="@+id/btn_junior"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:backgroundTint="@color/verde_boton"
            android:text="@string/cat_junior"
            android:textSize="11sp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            style="@style/TextAppearance.Minimoda.Boton" />
    </LinearLayout>

    <!-- BANNER NOVEDADES -->
    <Button
        android:id="@+id/btn_banner"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/verde_boton"
        android:text="@string/banner_novedades"
        style="@style/TextAppearance.Minimoda.Boton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categorias" />

    <!-- SECCIÓN MÁS VENDIDOS -->
    <TextView
        android:id="@+id/tv_mas_vendidos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/seccion_mas_vendidos"
        style="@style/TextAppearance.Minimoda.Titulo"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_banner" />

    <!-- PRODUCTO 1: Conjunto Lino -->
    <ImageView
        android:id="@+id/img_producto1"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/conjuntolino"
        app:layout_constraintEnd_toStartOf="@id/img_producto2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_mas_vendidos" />

    <TextView
        android:id="@+id/tv_prod1_nombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/producto_1_nombre"
        style="@style/TextAppearance.Minimoda.ProductoNombre"
        app:layout_constraintStart_toStartOf="@id/img_producto1"
        app:layout_constraintTop_toBottomOf="@id/img_producto1" />

    <TextView
        android:id="@+id/tv_prod1_precio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/producto_1_precio"
        style="@style/TextAppearance.Minimoda.ProductoPrecio"
        app:layout_constraintStart_toStartOf="@id/img_producto1"
        app:layout_constraintTop_toBottomOf="@id/tv_prod1_nombre"
        app:layout_constraintBottom_toTopOf="@id/layout_nav_inferior"
        app:layout_constraintVertical_bias="0.0" />

    <!-- PRODUCTO 2: Pelele algodón -->
    <ImageView
        android:id="@+id/img_producto2"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/pelele"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_producto1"
        app:layout_constraintTop_toBottomOf="@id/tv_mas_vendidos" />

    <TextView
        android:id="@+id/tv_prod2_nombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/producto_2_nombre"
        style="@style/TextAppearance.Minimoda.ProductoNombre"
        app:layout_constraintStart_toStartOf="@id/img_producto2"
        app:layout_constraintTop_toBottomOf="@id/img_producto2" />

    <TextView
        android:id="@+id/tv_prod2_precio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/producto_2_precio"
        style="@style/TextAppearance.Minimoda.ProductoPrecio"
        app:layout_constraintStart_toStartOf="@id/img_producto2"
        app:layout_constraintTop_toBottomOf="@id/tv_prod2_nombre" />

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:id="@+id/layout_nav_inferior"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#E5DDD5"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Inicio"
            android:textColor="@color/verde_boton"
            android:textStyle="bold"
            android:drawableTop="@android:drawable/ic_menu_compass"
            android:drawableTint="@color/verde_boton"
            android:paddingTop="6dp"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cesta"
            android:textColor="@color/texto_secundario"
            android:drawableTop="@android:drawable/ic_menu_agenda"
            android:drawableTint="@color/texto_secundario"
            android:paddingTop="6dp"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Perfil"
            android:textColor="@color/texto_secundario"
            android:drawableTop="@android:drawable/ic_menu_myplaces"
            android:drawableTint="@color/texto_secundario"
            android:paddingTop="6dp"
            android:textSize="11sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>